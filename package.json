{
  "name": "painel-academico",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint --max-warnings 0 src tests functions *.config.js vite.chunks.js && prettier --check . src functions",
    "format": "prettier --write . src functions && eslint --fix src tests functions *.config.js vite.chunks.js",
    "check": "npm run lint && vitest run && vite build",
    "funcoes:sincronizar": "node -e \"require('fs').copyFileSync('src/utils/lembretes.js','functions/compartilhado/lembretes.js')\""
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "lucide-react": "^0.383.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "vite": "^7.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.12",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7",
    "workbox-build": {
      "glob": "^14.0.6"
    }
  }
}
